{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "SlashCommand",
      "Task",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "ToolSearch"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(**/.env*)",
      "Read(./secrets/**)",
      "Read(./.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-main-commit.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking branch (no commits to main)…"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
